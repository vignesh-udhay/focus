<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- A focus session's estimate running out while the user is in another
         app. Requested when the first session with an estimate starts, never
         at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Exact alarms, asked for at the first reminder. D-078: Play allows
         USE_EXACT_ALARM only for alarm, timer and calendar apps, and points
         everything else here. From Android 14 a fresh install starts without
         the grant, so ReminderPermissionGate asks, the Today banner says so
         while it is missing, and a later grant reconciles every alarm. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Every alarm the system held is gone after a restart. Without this the
         app cannot know a reminder was ever set. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The manufacturer battery and autostart screens the reminder health
         screen routes to. From Android 11 a package this app has not named is
         invisible to it, so without these the deep link silently degrades to
         the generic settings page on every device that needs it. The list is
         mirrored in core/notification/DeviceSettingsRoute.kt, and a test
         checks the two agree. -->
    <queries>
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.coloros.oppoguardelf" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.oneplus.security" />
        <package android:name="com.samsung.android.lool" />
        <package android:name="com.samsung.android.sm" />
        <package android:name="com.huawei.systemmanager" />
    </queries>

    <application
        android:name=".FocuslistApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Focuslist">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.Focuslist"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not exported: only AlarmManager delivers to it, on our own
             PendingIntent. -->
        <receiver
            android:name=".core.notification.FocusEstimateReceiver"
            android:exported="false" />

        <!-- Not exported: only AlarmManager delivers to it, on our own
             PendingIntent. -->
        <receiver
            android:name=".core.notification.ReminderReceiver"
            android:exported="false" />

        <!-- Not exported: only the notification's own PendingIntents reach it,
             and they are created by this app. -->
        <receiver
            android:name=".core.notification.ReminderActionReceiver"
            android:exported="false" />

        <!-- Not exported: only AlarmManager delivers to it, on our own
             PendingIntent. -->
        <receiver
            android:name=".core.notification.TestReminderReceiver"
            android:exported="false" />

        <!-- Exported, because the system sends all five of these from outside
             the app. A restart loses every alarm, and a clock or timezone
             change moves what the surviving ones mean, so all of them lead to
             the same reconciliation. TIME_SET and TIMEZONE_CHANGED are on
             Android's implicit-broadcast exception list, so a manifest
             receiver still gets them with the app closed. The exact-alarm
             grant is too, and it is what turns alarms set inexactly while the
             grant was missing into exact ones, whichever screen granted it.
             D-078. -->
        <receiver
            android:name=".core.notification.ReminderRecoveryReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".ui.widget.FocuslistWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/focuslist_widget_info" />
        </receiver>

        <receiver
            android:name=".ui.widget.FocuslistWidgetRefreshReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reminders, and a focus session's estimate running out while the user
         is in another app. Requested at the first reminder or the first
         session with an estimate, never at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Exact alarms, asked for at the first reminder. D-078: Play allows
         USE_EXACT_ALARM only for alarm, timer and calendar apps, and points
         everything else here. From Android 14 a fresh install starts without
         the grant, so ReminderPermissionGate asks, the Today banner says so
         while it is missing, and a later grant reconciles every alarm. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Every alarm the system held is gone after a restart. Without this the
         app cannot know a reminder was ever set. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- "Ring like an alarm", D-102. Full screen over the lock screen: granted
         at install below Android 14; from 14 Play pre-grants it only to alarm
         and calling apps, so Tellcat asks the user, and rings as a heads-up
         until it is given. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- The alarm rings from a foreground service, because nothing the user
         does to the screen (Home, Back, the shade, the power button) may stop
         it. mediaPlayback: it plays a sound the user asked for, and unlike
         systemExempted it needs no exact-alarm grant. D-102. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- The alarm always vibrates, and keeps the CPU awake while it plays. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- The manufacturer battery and autostart screens the reminder health
         screen routes to. From Android 11 a package this app has not named is
         invisible to it, so without these the deep link silently degrades to
         the generic settings page on every device that needs it. The list is
         mirrored in core/notification/DeviceSettingsRoute.kt, and a test
         checks the two agree. -->
    <queries>
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.coloros.oppoguardelf" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.oneplus.security" />
        <package android:name="com.samsung.android.lool" />
        <package android:name="com.samsung.android.sm" />
        <package android:name="com.huawei.systemmanager" />
    </queries>

    <application
        android:name=".TellcatApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tellcat">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.Tellcat"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Add to Tellcat" in other apps' share sheets, over the app shared
             from. D-097. Left out of Recents: it is a moment inside that app.
             No task affinity, so a sender that starts it as a new task does not
             bring Tellcat's own window up behind it. -->
        <activity
            android:name=".ui.share.ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:label="@string/share_target_label"
            android:theme="@style/Theme.Tellcat.Translucent"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Not exported: only AlarmManager delivers to it, on our own
             PendingIntent. -->
        <receiver
            android:name=".core.notification.FocusEstimateReceiver"
            android:exported="false" />

        <!-- Not exported: only AlarmManager delivers to it, on our own
             PendingIntent. Direct-boot aware, so a reminder due before the
             first unlock after a restart still rings. D-079. -->
        <receiver
            android:name=".core.notification.ReminderReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <!-- Not exported: only the notification's own PendingIntents reach it,
             and they are created by this app. -->
        <receiver
            android:name=".core.notification.ReminderActionReceiver"
            android:exported="false" />

        <!-- Rings an alarm-style reminder until it is answered. D-102. Started
             by ReminderReceiver, and answered by its own notification and the
             alarm screen. Direct-boot aware, so an alarm due before the first
             unlock after a restart still rings. -->
        <service
            android:name=".core.notification.AlarmRingService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- The alarm, full screen over the lock screen. D-102. Only the
             full-screen intent and the alarm's notification open it. Its own
             task, out of Recents: it is a moment, not a place in the app. -->
        <activity
            android:name=".AlarmActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Tellcat"
            android:turnScreenOn="true" />

        <!-- Not exported: only AlarmManager delivers to it, on our own
             PendingIntent. -->
        <receiver
            android:name=".core.notification.TestReminderReceiver"
            android:exported="false" />

        <!-- Exported, because the system sends all five of these from outside
             the app. A restart loses every alarm, and a clock or timezone
             change moves what the surviving ones mean, so all of them lead to
             the same reconciliation. TIME_SET and TIMEZONE_CHANGED are on
             Android's implicit-broadcast exception list, so a manifest
             receiver still gets them with the app closed. The exact-alarm
             grant is too, and it is what turns alarms set inexactly while the
             grant was missing into exact ones, whichever screen granted it.
             D-078. -->
        <receiver
            android:name=".core.notification.ReminderRecoveryReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <!-- Before the first unlock after a restart. D-079. -->
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".ui.widget.TellcatWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tellcat_widget_info" />
        </receiver>

        <receiver
            android:name=".ui.widget.TellcatWidgetRefreshReceiver"
            android:enabled="true"
            android:exported="true">
            <!-- DATE_CHANGED is gone: a manifest receiver never gets it. The
                 widget's own midnight alarm replaces it, and these re-arm it.
                 D-079. -->
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>

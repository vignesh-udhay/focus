<?xml version="1.0" encoding="utf-8"?>
<!--
    The "New task" shortcut's icon, D-132: Quick Add's own add glyph on the
    launcher icon's P30 background, so it reads as Tellcat's beside the icon it
    comes from. Monochrome for themed icons, as the launcher icon has.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_shortcut_new_task_foreground" />
    <monochrome android:drawable="@drawable/ic_shortcut_new_task_foreground" />
</adaptive-icon>

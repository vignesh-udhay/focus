<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher icon's background layer: one flat tone, full bleed so every
    mask shape has something to crop.

    P30, the deepest tone of the primary palette and the one value that is
    load-bearing wherever the brand is visible without the user's own colours:
    it is `onPrimaryContainer` in light, `primaryContainer` in dark, and the
    eyes of the icon above it. Written as hex because a launcher draws outside
    the app's theme.

    It was `#FAF8FF` first. Measured at 36dp against a light launcher
    background, a near-white icon dissolves and the face becomes a smudge; on
    P30 the silhouette holds.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#FF403D89" />
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and earlier, which read this file instead of
  data_extraction_rules.xml. The same rules, for the same reasons: D-080.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="focus_session.xml" />
    <exclude domain="sharedpref" path="widget_interaction.xml" />
    <exclude domain="sharedpref" path="reminder_health_acknowledgements.xml" />
    <exclude domain="sharedpref" path="reminder_scheduling.xml" />
    <exclude domain="device_sharedpref" path="locked_reminders.xml" />
</full-backup-content>
